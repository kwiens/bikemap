{
  "name": "bikemap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "js-yaml@4": "4.3.2",
      "undici@7": "7.29.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "ci": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ci-build.ts",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck && eslint . --max-warnings 0 && biome lint --error-on-warnings && biome format",
    "lint:fix": "eslint . --fix --max-warnings 0 && biome lint --write --unsafe && biome format --write",
    "prepare": "husky",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:up": "docker compose up -d",
    "db:migrate": "cross-env PAYLOAD_MIGRATING=true payload migrate",
    "db:migrate:create": "payload migrate:create",
    "db:seed:bend": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed/bend.ts",
    "db:seed:chattanooga": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed/chattanooga.ts",
    "prepare:chattanooga-measurements": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prepare_chattanooga_measurements.ts",
    "backfill:elevation": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backfill-elevation-profiles.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "graphql": "^16.14.2",
    "lucide-react": "^1.17.0",
    "mapbox-gl": "^3.24.0",
    "next": "16.3.5",
    "payload": "3.90.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "terra-draw": "^1.32.2",
    "terra-draw-mapbox-gl-adapter": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vercel/config": "^0.7.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.6",
    "typescript": "^6.0.3",
    "vite": "7.3.5",
    "vitest": "^4.1.8"
  }
}
