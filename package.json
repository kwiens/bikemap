{
  "name": "bikemap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.6",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "dompurify@3": "3.4.13",
      "js-yaml@4": "4.3.2",
      "postcss-selector-parser@6": "6.1.3",
      "undici@7": "7.29.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "ci": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ci-build.ts",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --cache --cache-strategy content --cache-location .cache/eslint/.eslintcache --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0 && pnpm format:fix",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "knip": "knip --no-progress --cache --cache-location .cache/knip",
    "dedupe:check": "pnpm dedupe --check",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm knip && pnpm dedupe:check",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:up": "docker compose up -d",
    "db:migrate": "cross-env PAYLOAD_MIGRATING=true payload migrate",
    "db:migrate:create": "payload migrate:create",
    "db:seed:bend": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed/bend.ts",
    "db:seed:chattanooga": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed/chattanooga.ts",
    "prepare:chattanooga-measurements": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prepare_chattanooga_measurements.ts",
    "backfill:elevation": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backfill-elevation-profiles.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "clsx": "2.1.1",
    "graphql": "17.0.2",
    "lucide-react": "1.45.0",
    "mapbox-gl": "3.31.0",
    "next": "16.3.5",
    "payload": "3.90.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "terra-draw": "1.33.0",
    "terra-draw-mapbox-gl-adapter": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@eslint-react/eslint-plugin": "5.20.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/config": "0.7.1",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "6.37.0",
    "lint-staged": "17.5.1",
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
