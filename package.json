{
  "name": "bikemap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.6",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "dompurify@3": "3.4.13",
      "js-yaml@4": "4.3.2",
      "postcss-selector-parser@6": "6.1.3",
      "undici@7": "7.29.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "ci": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ci-build.ts",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0 && pnpm format:fix",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "knip": "knip --no-progress",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm knip",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:up": "docker compose up -d",
    "db:migrate": "cross-env PAYLOAD_MIGRATING=true payload migrate",
    "db:migrate:create": "payload migrate:create",
    "db:seed:bend": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed/bend.ts",
    "db:seed:chattanooga": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed/chattanooga.ts",
    "prepare:chattanooga-measurements": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prepare_chattanooga_measurements.ts",
    "backfill:elevation": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backfill-elevation-profiles.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "lucide-react": "^1.17.0",
    "mapbox-gl": "^3.24.0",
    "next": "16.3.5",
    "payload": "3.90.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "terra-draw": "^1.32.2",
    "terra-draw-mapbox-gl-adapter": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vercel/config": "^0.7.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.37.0",
    "lint-staged": "^17.0.7",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.6",
    "typescript": "^6.0.3",
    "vite": "7.3.5",
    "vitest": "^4.1.8"
  }
}
