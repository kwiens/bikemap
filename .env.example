# Copy this file to .env.local and fill in the values.
#
# Mapbox public access token — required for the map to render.
# It is a public token (starts with "pk.") and is exposed to the browser;
# scope it to your domains in the Mapbox dashboard.
# Create one at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: default city when the hostname is not listed below.
# Valid values: chattanooga, bend
NEXT_PUBLIC_CITY_ID=chattanooga

# Optional: host-to-city routing for one Vercel project serving multiple domains.
# This value is public and bundled into the browser app.
NEXT_PUBLIC_CITY_HOST_MAP='{"bikechatt.com":"chattanooga","www.bikechatt.com":"chattanooga","ridebend.org":"bend","www.ridebend.org":"bend"}'

# --- Content backend (Payload + OSM trail editor) ----------------------------
# Only needed to run the /admin content editor. The public map works without
# these; it renders from the checked-in TypeScript data.
#
# The trail editor also uses NEXT_PUBLIC_MAPBOX_TOKEN above: it samples Mapbox
# Terrain-RGB for elevation. Without it a trail still gets geometry and
# distance, just no climb figures.

# Postgres connection string. `docker compose up -d` starts a local Postgres
# matching this URL. No extensions required.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bikemap

# Set to `disable` for a local database with no TLS. Managed Postgres
# (Supabase, Neon, RDS) generally needs this unset or `require`.
DATABASE_SSL=disable

# Secret used to sign Payload's auth tokens. Generate your own — any long
# random string. NEVER commit the real value.
#   openssl rand -base64 32
PAYLOAD_SECRET=
